    },
    "./content": {
      "types": "./dist/content/index.d.ts",
      "import": "./dist/content/index.js"
    },
    "./seo": {
      "types": "./dist/seo/index.d.ts",
      "import": "./dist/seo/index.js"
    }
  },
  "dependencies": {
    "htmlparser2": "^12.0.0",
    "zod": "^4.6.7"
  },
  "gitHead": "b0e82399081cf1b52f7d23456cdb2de637f21163"
